# Copy to .env (never commit .env). All variables are optional.
SQLY_DB_PATH=data/sqlyapper.db
SQLY_AUTO_SEED=true

# Result-size and resource limits
SQLY_MAX_ROWS=100
SQLY_DEFAULT_LIMIT=50
SQLY_MAX_OFFSET=10000
SQLY_QUERY_TIMEOUT_MS=2000
SQLY_MAX_RESPONSE_BYTES=1000000

# Request limits
SQLY_MAX_BODY_BYTES=16384
SQLY_MAX_QUESTION_CHARS=1000
SQLY_MAX_SQL_CHARS=5000

# Query complexity
SQLY_MAX_NESTING_DEPTH=3
SQLY_MAX_JOINS=6
SQLY_MAX_AST_NODES=600

# LLM: "mock" (deterministic, default) or "anthropic"
SQLY_LLM_PROVIDER=mock
SQLY_MAX_CORRECTIONS=2
# SQLY_LLM_MODEL=<model id>
# SQLY_LLM_API_KEY=<secret>
SQLY_LLM_TIMEOUT_S=30

SQLY_LOG_LEVEL=INFO
