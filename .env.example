# ---------------------------------------------------------------------------
# SQLYapper configuration. Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# development | production (production enforces secure cookies + strong secret)
SQLY_ENV=development

# --- LLM: Groq (free tier) --------------------------------------------------
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
SQLY_LLM_PROVIDER=groq                    # groq | mock (offline demo, no key needed)
SQLY_GROQ_SQL_MODEL=openai/gpt-oss-120b      # drafts SQL (Llama 3.x was retired from Groq on 2026-08-16)
SQLY_GROQ_FAST_MODEL=openai/gpt-oss-20b      # routing + answer summaries
SQLY_GROQ_REASONING_EFFORT=medium          # low | medium | high, used when drafting SQL
SQLY_LLM_TIMEOUT_S=30
SQLY_LLM_MAX_RETRIES=2                    # retries on 429/5xx from Groq
SQLY_MAX_CORRECTIONS=2                    # hard ceiling is 2
SQLY_SUMMARIZE_RESULTS=true
SQLY_HISTORY_TURNS=3                      # follow-up questions use the last N turns

# --- Auth & cookies ---------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SQLY_SECRET_KEY=change-me-to-a-long-random-string
SQLY_SESSION_TTL_HOURS=168
SQLY_COOKIE_SECURE=false                  # set true when served over HTTPS
SQLY_COOKIE_SAMESITE=lax
SQLY_ALLOW_SIGNUP=true
SQLY_PASSWORD_MIN_LENGTH=10
SQLY_LOGIN_RATE_PER_MINUTE=10
SQLY_CHAT_RATE_PER_MINUTE=20

# --- Storage ----------------------------------------------------------------
SQLY_DATA_DIR=data
SQLY_APP_DB_PATH=data/app.db
SQLY_DB_PATH=data/sample.db
SQLY_AUTO_SEED=true

# --- Uploads ----------------------------------------------------------------
SQLY_MAX_UPLOAD_MB=20
SQLY_MAX_FILES_PER_DATASET=10
SQLY_MAX_ROWS_PER_TABLE=500000
SQLY_MAX_COLUMNS_PER_TABLE=100
SQLY_MAX_DATASETS_PER_USER=20

# --- Query limits -----------------------------------------------------------
SQLY_MAX_ROWS=100
SQLY_DEFAULT_LIMIT=50
SQLY_MAX_OFFSET=10000
SQLY_QUERY_TIMEOUT_MS=3000
SQLY_MAX_RESPONSE_BYTES=1000000
SQLY_MAX_BODY_BYTES=16384
SQLY_MAX_QUESTION_CHARS=1000
SQLY_MAX_SQL_CHARS=5000
SQLY_MAX_NESTING_DEPTH=3
SQLY_MAX_JOINS=6
SQLY_MAX_AST_NODES=600

# --- Operations ---------------------------------------------------------------
SQLY_LOG_LEVEL=INFO
SQLY_LOG_FORMAT=text                     # text (local) | json (production; Docker sets json)
SQLY_RATE_LIMIT_BACKEND=shared           # shared (all workers on the host) | memory (single process)
# Bearer token for GET /metrics. Without one, /metrics is open in development and off in production.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SQLY_METRICS_TOKEN=
# Send traces to Jaeger / an OTel Collector over OTLP/HTTP (leave empty to disable).
# With docker compose --profile observability use: http://jaeger:4318
SQLY_OTEL_EXPORTER_ENDPOINT=
SQLY_OTEL_SERVICE_NAME=sqlyapper

# --- Docker Compose only ------------------------------------------------------
# Your domain for automatic HTTPS (Let's Encrypt). "localhost" uses Caddy's local CA.
SITE_ADDRESS=localhost
